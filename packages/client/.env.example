# Client environment variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Bind locally and reject untrusted Host headers by default.
HOST=127.0.0.1
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Authentication ---
# Set VITE_API_KEY to match the server's API_KEY.
# Leave unset for open access (local dev).
# VITE_API_KEY=your-secret-key

# Optional WebSocket endpoint override (for example wss://board.example.com/ws).
# Leave unset to use localhost:8080 from the local 8081 dev client and same-origin /ws elsewhere.
# VITE_WS_URL=ws://127.0.0.1:8080/ws
